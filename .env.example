# Copy this file to .env and fill in real values. .env is gitignored — never commit secrets.

# Required: OpenAI (or Azure OpenAI) API key used by the rag/ pathway for embeddings + generation.
OPENAI_API_KEY=

# Optional: set these instead of OPENAI_API_KEY to route rag/ through Azure OpenAI.
# When AZURE_OPENAI_ENDPOINT is set, rag/config.py prefers Azure OpenAI over plain OpenAI.
# AZURE_OPENAI_ENDPOINT must be the resource root only (no /openai/... path), e.g.
# https://<your-resource-name>.openai.azure.com or https://<your-resource-name>.services.ai.azure.com
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Exact deployment names from your resource's Deployments tab (not model names).
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# Optional overrides (defaults live in rag/config.py)
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CHAT_MODEL=gpt-4o-mini
RAG_CHROMA_DIR=rag/.chroma_store
